# OPENAI_API_KEY: Required for Complete Sheet, lookup, and other AI calls.
# Keep this in a gitignored .env.local at the project root.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# Optional model override. Defaults to gpt-4o-mini, then gpt-4o.
# OPENAI_MODEL="gpt-4o-mini"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
